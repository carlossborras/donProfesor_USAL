# =============================================================================
# DONPROFESOR (#Hack4Edu 2026, Reto 13) · Plantilla de Variables de Entorno
# Copia este archivo a `.env` (`cp .env.example .env`) para configurar tu entorno
# =============================================================================

# 1. Conexión con el Modelo LLM (Qwen / vLLM local o en red de tu compañero)
# Por defecto apunta a vLLM en el puerto 8001
QWEN_BASE_URL=http://localhost:8001/v1
QWEN_MODEL_NAME=donprofesor-llm
QWEN_API_KEY=pide_la_clave_por_privado_a_quien_ejecuta_vllm

# 2. Seguridad JWT para autenticación de roles institucionales
# Genera uno propio (mín. 32 caracteres): python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si falta o es débil, la API usa uno aleatorio temporal (las sesiones caducan al reiniciar)
DONPROFESOR_JWT_SECRET=
DONPROFESOR_JWT_EXPIRE_HOURS=8

# 2b. Registro de cuentas (opcional): si defines un código, registrarse con ese rol lo exigirá.
# Recomendado para director y delegado; déjalo vacío para registro libre.
DONPROFESOR_CODIGO_REGISTRO_DOCENTE=
DONPROFESOR_CODIGO_REGISTRO_DIRECTOR=
DONPROFESOR_CODIGO_REGISTRO_DELEGADO=
# Cuentas de demostración docente/director/delegado (contraseña pública donprofesor2026).
# Pon 0 en cualquier despliegue accesible desde fuera.
DONPROFESOR_CREAR_USUARIOS_DEMO=1

# 3. Base de Datos
# Por defecto se utiliza SQLite local (db/donprofesor.db) conectada a la aplicación
# Si deseas conectar a un PostgreSQL externo, descomenta y ajusta:
# DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/donprofesor

# 4. Modelo de predicción (LightGBM + Random Forest, entrenado con entrenadorModelo.py)
# Ruta del paquete .joblib. Si no existe o no se puede cargar, los estudiantes se guardan igual
# y sus predicciones quedan «pendientes» (nunca se inventan).
DONPROFESOR_MODEL_PATH=modelo.joblib
# Umbrales (0-1) para leer una probabilidad como nivel alto / medio
DONPROFESOR_UMBRAL_RIESGO_ALTO=0.5
DONPROFESOR_UMBRAL_RIESGO_MEDIO=0.2
# Índice de desánimo (0-10) a partir del cual se considera alto / medio
DONPROFESOR_DESANIMO_ALTO=7
DONPROFESOR_DESANIMO_MEDIO=5
# Privacidad: grupos con menos de K estudiantes no se muestran a director ni delegado
DONPROFESOR_K_MINIMO=5

# 5. Simulador de subvenciones del delegado
DONPROFESOR_MONEDA=PEN
DONPROFESOR_DISTANCIA_TRANSPORTE_KM=3
DONPROFESOR_UMBRAL_CONECTIVIDAD_PCT=50

# 6. Tiempo máximo de espera al LLM (segundos)
QWEN_TIMEOUT_SECONDS=30
